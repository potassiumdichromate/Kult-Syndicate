# Host paths to managed secret files outside the repository. Never put the values in this file.
PUBLIC_ORIGIN=https://syndicates.example.com
SYNDICATES_LAUNCH_SECRET_FILE=/absolute/path/to/launch-secret.txt
SYNDICATES_CALLBACK_SECRET_FILE=/absolute/path/to/callback-secret.txt
SYNDICATES_SIGNING_KEY_FILE=/absolute/path/to/receipt-signing-key.pem
KULT_WORLD_RECEIPT_URL=https://world.example.com/api/syndicates/receipt
# Configure the same launch secret, callback verification secret, and pinned public key on KULT World.
# KULT_SYNDICATES_URL=https://syndicates.example.com/world/syndicates/
# KULT_SYNDICATES_PUBLIC_KEY=<publicKey returned by /api/public-key>
